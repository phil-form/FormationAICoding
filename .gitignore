# Build
target/

# Secrets / environnement
.env
.env.dev

# Dumps de base et certificats TLS (seuls les dossiers sont versionnés)
init_db/*
!init_db/.gitkeep
certs/*
!certs/.gitkeep
backups/
reports/
secrets/

# Claude Code : état local (progression des tests, logs, retour de tests)
.claude/state/
.claude/settings.local.json

# IDE
.idea/workspace.xml
.idea/shelf/

*.log

# Claude Code worktrees (local, never versioned)
/.claude/worktrees/
/.worktree-backup/
