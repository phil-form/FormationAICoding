# Copier en .env (jamais commité) puis adapter : cp .env.example .env
COMPOSE_PROJECT_NAME=formation

# Utilisateur hôte (fichiers créés par le conteneur dev)
HOST_UID=1000
HOST_GID=1000

# --- Base de données ---------------------------------------------------------
DB_NAME=formation
DB_USER=formation
DB_PASSWORD=change-me-with-a-long-random-password
DB_PORT=5432                      # publié sur 127.0.0.1 uniquement

# --- API dev -----------------------------------------------------------------
API_PORT=8080
DEBUG_PORT=5005

# --- API prod (derrière HAProxy) ---------------------------------------------
API_DOMAIN=api.example.be         # nom public (certificat Let's Encrypt, SNI HAProxy → API)
API_BIND=127.0.0.1                # interface publiée pour HAProxy (jamais 0.0.0.0 si HAProxy est sur l'hôte)
API_HTTPS_PORT=8443               # port publié pour HAProxy
PUBLIC_HOST=                      # nom public pour d'éventuelles redirections (vide = Host de la requête)
PUBLIC_HTTPS_PORT=443
TLS_CERT_DIR=./certs              # serveur : /srv/formation/certs (alimenté par le deploy hook certbot)
TLS_CERT_GID=1000                 # groupe propriétaire de la clé (serveur : groupe dédié, ex. formation-tls)
DOCKER_SUBNET=172.30.0.0/24       # réseau du projet ; sa passerelle = IP de HAProxy (sur l'hôte) vue par l'API
TRUSTED_PROXIES='172\.30\.0\.1'    # regex des IP de proxy de confiance (HAProxy) ; à adapter si DOCKER_SUBNET change

# --- CORS ----------------------------------------------------------------------
# Prod : origines HTTPS explicites, séparées par des virgules (le démarrage échoue sinon).
# Dev : http://localhost:* et http://127.0.0.1:* sont toujours autorisés en plus.
CORS_ALLOWED_ORIGINS=https://localhost:4200
