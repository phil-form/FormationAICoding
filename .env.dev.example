# Secrets de DÉVELOPPEMENT injectés dans OpenBao (dev) par le service openbao-init.
# Copier en .env.dev (jamais commité) : cp .env.dev.example .env.dev
# En production, aucun de ces fichiers n'existe : les secrets vivent dans OpenBao (sauvegarde : 1Password).

# Jeton root du serveur OpenBao en mode dev (en mémoire, recréé à chaque démarrage).
BAO_DEV_ROOT_TOKEN_ID=dev-root-token-change-me

# Mot de passe du rôle PostgreSQL openbao_admin (crée/révoque les utilisateurs dynamiques).
OPENBAO_DB_ADMIN_PASSWORD=dev-openbao-admin-change-me

# role_id fixe de l'AppRole "api" en dev (UUID quelconque) : identifiants stables d'un démarrage à l'autre.
APPROLE_ROLE_ID=6b0f6f9e-2f43-4d5e-9b39-0c8a5c1d7e21

# Secrets applicatifs statiques : chaque APP_SECRET_<NOM> devient la clé <nom> de kv/formation.
# (Les clés JWT et NISS ne sont PAS ici : elles sont générées dans Transit et ne sortent jamais d'OpenBao.)
# Attention : une valeur commençant par @ ou égale à - est interprétée par la CLI bao (fichier / stdin).
APP_SECRET_EXAMPLE_API_KEY=dev-example-value

# Mot de passe commun des comptes de démonstration admin / gestionnaire / conducteur (./start.sh --seed uniquement,
# feature 001 RG-18). Au moins 12 caractères, non blanc (sinon le démarrage avec --seed échoue). Transmis à api-dev
# seulement (propriété app.seed.demo-password) ; jamais lu dans kv/formation, jamais utilisé en prod
# (exception documentée à ADR 0001 D9).
SEED_DEMO_PASSWORD=change-me-demo-password
