{% extends '::base.html.twig' %}

{% block body %}
    <h1>Véhicules</h1>

    <form method="get">
        <select name="status">
            <option value="">Tous</option>
            {% for value, label in statusLabels %}
                <option value="{{ value }}"{% if status is not null and status != '' and status == value %} selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
        <button type="submit">Filtrer</button>
    </form>

    <table>
        <thead>
            <tr><th>Plaque</th><th>Véhicule</th><th>Kilométrage</th><th>Statut</th></tr>
        </thead>
        <tbody>
            {% for vehicle in vehicles %}
                <tr>
                    <td><a href="{{ path('vehicle_show', { 'id': vehicle.id }) }}">{{ vehicle.plate|plate }}</a></td>
                    <td>{{ vehicle.brand }} {{ vehicle.model }}</td>
                    <td>{{ vehicle.mileage|km }}</td>
                    <td>{{ vehicle.statusLabel }}</td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun véhicule.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
