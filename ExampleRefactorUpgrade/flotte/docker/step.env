# Étape courante de la migration — lu par docker compose (--env-file) et par les skills/orchestrateurs.
# Modifié uniquement par /php-step et /upgrade-step (agent migrator). Référence : .claude/reference/steps.json
STEP=step-00
PHP_VERSION=7.2
PHP_FAMILY=php72
SYMFONY_VERSION=2.8
# Dossier public et front controller servis par Apache (web/app.php jusqu'à step-01, public/index.php ensuite)
APP_PUBLIC_DIR=web
APP_FRONT_CONTROLLER=app.php
# Horloge de référence (libfaketime) : démarre au 15/01/2026 10:00 à chaque lancement de processus puis avance
# normalement. Une horloge totalement figée bloque PHP (uniqid() attend un changement d'heure → boucle infinie).
FAKETIME=@2026-01-15 10:00:00
TZ=Europe/Brussels
LC_ALL=C.UTF-8
