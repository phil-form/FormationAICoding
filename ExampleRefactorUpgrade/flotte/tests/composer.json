{
    "name": "flotte/characterization-tests",
    "description": "Tests de caractérisation boîte noire de flotte (migration PHP 8.4 / Symfony 6.4) — conteneur tests",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-pdo_sqlite": "*",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/http-client": "^7.3",
        "symfony/dom-crawler": "^7.3",
        "symfony/css-selector": "^7.3"
    },
    "autoload-dev": {
        "psr-4": { "Flotte\\Tests\\": "src/" }
    },
    "config": {
        "sort-packages": true,
        "platform": { "php": "8.4.0" }
    }
}
